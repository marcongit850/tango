{
  "name": "tango",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var APP_ENV:development",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply tango --local",
    "db:migrate:remote": "wrangler d1 migrations apply tango --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "hono": "^4.9.8"
  }
}
